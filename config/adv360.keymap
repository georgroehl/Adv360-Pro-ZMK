#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/rgb.h>

#define MAC_BASE 0
#define WINDOWS_BASE 1
#define KEYPAD 2
#define MAC_FN 3
#define WINDOWS_FN 4
#define LAYER_MOD 5

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        mac_a_umlaut: mac_a_umlaut {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mac_a_umlaut_lower>, <&mac_a_umlaut_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_o_umlaut: mac_o_umlaut {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mac_o_umlaut_lower>, <&mac_o_umlaut_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_u_umlaut: mac_u_umlaut {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mac_u_umlaut_lower>, <&mac_u_umlaut_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_e_acute: mac_e_acute {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mac_e_acute_lower>, <&mac_e_acute_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_n_tilde: mac_n_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mac_n_tilde_lower>, <&mac_n_tilde_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_c_cedilla: mac_c_cedilla {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(C)>, <&kp LA(LS(C))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_sharp_s: mac_sharp_s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(S)>, <&upper_ss>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_a_umlaut: windows_a_umlaut {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(Q)>, <&kp RA(LS(Q))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_o_umlaut: windows_o_umlaut {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(P)>, <&kp RA(LS(P))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_u_umlaut: windows_u_umlaut {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(Y)>, <&kp RA(LS(Y))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_e_acute: windows_e_acute {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(E)>, <&kp RA(LS(E))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_n_tilde: windows_n_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(N)>, <&kp RA(LS(N))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_c_cedilla: windows_c_cedilla {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(COMMA)>, <&kp RA(LS(COMMA))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_sharp_s: windows_sharp_s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(S)>, <&upper_ss>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_quote_literal: win_quote_literal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&win_literal_apostrophe>, <&win_literal_quote>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_grave_tilde_literal: win_grave_tilde_literal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&win_literal_grave>, <&win_literal_tilde>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_six_caret_literal: win_six_caret_literal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&win_literal_caret>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_acute_umlaut_dead: mac_acute_umlaut_dead {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(E)>, <&kp LA(U)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_grave_tilde_dead: mac_grave_tilde_dead {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE)>, <&kp LA(N)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_circumflex_dead: mac_circumflex_dead {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(I)>, <&kp LA(I)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_acute_umlaut_dead: windows_acute_umlaut_dead {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_grave_tilde_dead: windows_grave_tilde_dead {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        windows_circumflex_dead: windows_circumflex_dead {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp CARET>, <&kp CARET>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Mac";
            bindings = <
&kp EQUAL  &kp N1     &kp N2      &kp N3            &kp N4             &kp N5  &tog KEYPAD                                                           &mo LAYER_MOD      &kp N6  &kp N7    &kp N8        &kp N9    &kp N0     &kp MINUS
&kp TAB    &kp Q      &kp W       &kp E             &kp R              &kp T   &kp LA(LG(LCTRL))                                                     &kp C_VOLUME_UP    &kp Y   &kp U     &kp I         &kp O     &kp P      &kp BSLH
&kp ESC    &kp A      &kp S       &kp D             &kp F              &kp G   &none              &kp LCTRL  &kp LALT          &kp RCTRL  &kp LGUI   &kp C_VOLUME_DOWN  &kp H   &kp J     &kp K         &kp L     &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X       &kp C             &kp V              &kp B                                 &kp HOME          &kp PG_UP                                &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH   &kp RSHFT
&mo MAC_FN &kp GRAVE  &kp ESCAPE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET          &kp BSPC           &kp LGUI   &kp LEFT_ALT      &kp PG_DN  &kp ENTER  &kp SPACE                  &kp LEFT  &kp UP_ARROW  &kp DOWN  &kp RIGHT  &mo MAC_FN
            >;
        };

        windows {
            display-name = "Windows";
            bindings = <
&kp EQUAL      &kp N1     &kp N2      &kp N3            &kp N4             &kp N5  &tog KEYPAD                                                           &mo LAYER_MOD      &win_six_caret_literal  &kp N7    &kp N8        &kp N9    &kp N0     &kp MINUS
&kp TAB        &kp Q      &kp W       &kp E             &kp R              &kp T   &kp LA(LG(LCTRL))                                                     &kp C_VOLUME_UP    &kp Y                  &kp U     &kp I         &kp O     &kp P      &kp BSLH
&kp ESC        &kp A      &kp S       &kp D             &kp F              &kp G   &none             &kp LGUI  &kp LALT          &kp RGUI   &kp LCTRL  &kp C_VOLUME_DOWN  &kp H                  &kp J     &kp K         &kp L     &kp SEMI   &win_quote_literal
&kp LSHFT      &kp Z      &kp X       &kp C             &kp V              &kp B                                &kp HOME          &kp PG_UP                                &kp N                  &kp M     &kp COMMA     &kp DOT   &kp FSLH   &kp RSHFT
&mo WINDOWS_FN &win_grave_tilde_literal &kp ESCAPE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET          &kp BSPC           &kp LCTRL  &kp LEFT_ALT      &kp PG_DN  &kp ENTER  &kp SPACE                         &kp LEFT  &kp UP_ARROW  &kp DOWN  &kp RIGHT  &mo WINDOWS_FN
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo LAYER_MOD  &trans  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &trans     &trans        &trans     &trans     &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &trans
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&trans     &trans     &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &trans
            >;
        };

        mac_fn {
            display-name = "Mac Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4          &kp F5  &kp F6  &tog KEYPAD                                      &mo LAYER_MOD  &kp F7  &kp F8            &kp F9  &kp F10          &kp F11  &kp F12
&trans  &trans  &trans  &mac_e_acute    &trans  &trans  &none                                            &none          &trans  &mac_u_umlaut    &mac_circumflex_dead  &mac_o_umlaut  &trans  &trans
&trans  &mac_a_umlaut  &mac_sharp_s     &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none          &trans  &trans            &trans  &trans           &trans  &mac_acute_umlaut_dead
&trans  &trans  &trans  &mac_c_cedilla  &trans  &trans                  &trans  &trans                              &mac_n_tilde  &trans            &trans  &trans           &trans  &trans
&trans  &mac_grave_tilde_dead  &trans   &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans                 &trans  &trans            &trans  &trans  &trans
            >;
        };

        windows_fn {
            display-name = "Windows Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4              &kp F5  &kp F6  &tog KEYPAD                                      &mo LAYER_MOD  &kp F7  &kp F8                &kp F9  &kp F10              &kp F11  &kp F12
&trans  &trans  &trans  &windows_e_acute    &trans  &trans  &none                                            &none          &trans  &windows_u_umlaut    &windows_circumflex_dead  &windows_o_umlaut  &trans  &trans
&trans  &windows_a_umlaut  &windows_sharp_s &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none          &trans  &trans                &trans  &trans               &trans  &windows_acute_umlaut_dead
&trans  &trans  &trans  &windows_c_cedilla  &trans  &trans                  &trans  &trans                                  &windows_n_tilde  &trans                &trans  &trans               &trans  &trans
&trans  &windows_grave_tilde_dead  &trans   &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans                     &trans  &trans                &trans  &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &select_mac   &select_windows  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
